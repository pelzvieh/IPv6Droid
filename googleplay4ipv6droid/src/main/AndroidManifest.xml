<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPv6Droid_git">
        <activity
            android:name=".SelectProductActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IPv6Droid_git.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="de.flyingsnail.ipv6droid.REQUEST_TUNNEL"/>
                <data android:mimeType="application/pkcs10"/>
            </intent-filter>
        </activity>
        <activity
            android:name="de.flyingsnail.googleplay4ipv6droid.googlesubscription.SubscribeTunnelActivity"
            android:label="@string/title_activity_subscribe_tunnel"
            android:parentActivityName=".SelectProductActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="de.flyingsnail.ipv6droid.android.MainActivity" />
        </activity>

    </application>

</manifest>