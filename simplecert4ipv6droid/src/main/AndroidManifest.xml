<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="2"
    android:versionName="1.02">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPv6Droid_git">

        <activity
            android:name=".CertSetup"
            android:exported="true"
            android:theme="@style/Theme.IPv6Droid_git">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name=".action.SIGN"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="signing_request" android:host="flyingsnail.de"/>
            </intent-filter>
        </activity>

        <service android:name=".SimpleCertificationService"
            android:exported="true">
            <intent-filter>
                <action android:name="de.flyingsnail.ipv6droid.REQUEST_TUNNEL"/>
            </intent-filter>
        </service>
    </application>

</manifest>